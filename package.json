{
  "name": "software-space-semantic-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "dsh/package"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "npm run build --workspace @software-space/dsh-semantic",
    "typecheck": "npm run typecheck --workspace @software-space/dsh-semantic",
    "test": "npm run test --workspace @software-space/dsh-semantic",
    "test:composition": "npm run test:composition --workspace @software-space/dsh-semantic",
    "demo:minimal": "npm run build --silent && node examples/minimal/demo.mjs",
    "demo:dsh": "npm run build --silent && node examples/dsh-runtime/run.mjs",
    "demo": "npm run demo:minimal && npm run demo:dsh",
    "validate:skills": "node scripts/validate-skills.mjs",
    "checksums:generate": "node scripts/generate-checksums.mjs",
    "validate:package": "node scripts/validate.mjs",
    "verify:integrity": "node scripts/verify-integrity.mjs",
    "check": "npm run validate:skills && npm run typecheck && npm run test && npm run test:composition && npm run demo && npm run validate:package && npm run verify:integrity"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "22.20.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
